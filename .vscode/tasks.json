{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "python: run current file",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "-n",
        "diff310",
        "python",
        "${file}"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
